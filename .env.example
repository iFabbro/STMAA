# Alpaca Paper Trading API keys (create paper-trading credentials at https://alpaca.markets)
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# This entry point intentionally supports paper trading only.
STMAA_TRADING_MODE=paper
# Optional assertion only; any non-paper/custom URL is rejected.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risk configuration validated before the bot loop starts.
MAX_PORTFOLIO_EXPOSURE=0.50
MAX_DRAWDOWN=0.15
# Emergency liquidation is opt-in; accepted values: true/false, yes/no, on/off, 1/0.
LIQUIDATE_ON_DRAWDOWN=false

# FinRL-X Configuration
FINRL_X_ENV=development
