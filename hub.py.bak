#!/usr/bin/env python3
"""Trading Hub Dashboard - Monitoraggio Visivo STMAA (NO Streamlit)"""
import sys
from pathlib import Path

sys.path.append(str(Path(__file__).parent / "src"))

import os
from datetime import datetime, timedelta
import numpy as np

class Colors:
    HEADER = '\033[94m'
    TITLE = '\033[96m'
    POS = '\033[92m'
    NEG = '\033[91m'
    ACCENT = '\033[93m'
    MUTED = '\033[90m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'

def clear_screen():
    os.system('clear' if os.name == 'posix' else 'cls')

def print_header(text):
    print(f"\n{Colors.HEADER}{Colors.BOLD}{'='*70}{Colors.ENDC}")
    print(f"{Colors.HEADER}{Colors.BOLD}{text:^70}{Colors.ENDC}")
    print(f"{Colors.HEADER}{Colors.BOLD}{'='*70}{Colors.ENDC}\n")

def print_metric(label, value, change=None):
    change_str = ""
    if change is not None:
        color = Colors.POS if change > 0 else Colors.NEG
        symbol = "↑" if change > 0 else "↓"
        change_str = f" {color}{symbol}{change:+.2f}%{Colors.ENDC}"
    print(f"  {Colors.TITLE}{label:<25}{Colors.ENDC} {Colors.BOLD}{value}{Colors.ENDC}{change_str}")

def main():
    tickers = ['AAPL', 'GOOGL', 'MSFT', 'AMZN', 'TSLA', 'NVDA', 'META']

    clear_screen()
    print_header("📈 STMAA - Trading Multi-Agente Dashboard")

    print(f"{Colors.TITLE}Sistema:{Colors.ENDC} {Colors.POS}Attivo{Colors.ENDC}")
    print(f"{Colors.TITLE}Paper Trading:{Colors.ENDC} {Colors.POS}Abilitato{Colors.ENDC}")
    print(f"{Colors.TITLE}Ultimo aggiornamento:{Colors.ENDC} {datetime.now().strftime('%H:%M:%S')}{Colors.ENDC}")

    print_header("💰 Metriche Portafoglio")
    print_metric("Valore Portafoglio", "$100,000", 2.5)
    print_metric("Cash Disponibile", "$50,000", -1.2)
    print_metric("Total Equity", "$150,000", 1.8)
    print_metric("P&L Giornaliero", "+$2,500", 2.5)

    print_header("🏢 Tickers Monitorati (7)")
    print(f"\n{Colors.BOLD}{'Ticker':<10} {'Prezzo':>12} {'Variazione':>12} {'Peso':>10}{Colors.ENDC}")
    print(f"{Colors.UNDERLINE}{'-'*10} {'-'*12} {'-'*12} {'-'*10}{Colors.ENDC}")

    for ticker in tickers:
        price = np.random.uniform(100, 300)
        change = np.random.uniform(-3, 5)
        weight = np.random.uniform(0.1, 0.3)
        color = Colors.POS if change > 0 else Colors.NEG
        symbol = "↑" if change > 0 else "↓"
        print(f"  {Colors.BOLD}{ticker:<10}{Colors.ENDC} "
              f"${price:>9.2f} "
              f"{color}{symbol}{change:>6.2f}%{Colors.ENDC} "
              f"{weight*100:>6.2f}%")

    print_header("🔄 Ultime Operazioni")
    print(f"\n{Colors.BOLD}{'Timestamp':<20} {'Ticker':<8} {'Side':<8} {'Qty':>8} {'Prezzo':>12}{Colors.ENDC}")
    print(f"{Colors.UNDERLINE}{'-'*20} {'-'*8} {'-'*8} {'-'*8} {'-'*12}{Colors.ENDC}")

    for i in range(5):
        ts = datetime.now() - timedelta(minutes=i*5)
        ticker = np.random.choice(tickers)
        side = np.random.choice(['BUY', 'SELL'])
        qty = np.random.uniform(0.1, 2.0)
        price = np.random.uniform(100, 300)
        side_color = Colors.POS if side == 'BUY' else Colors.NEG
        print(f"  {ts.strftime('%H:%M:%S'):<20} "
              f"{Colors.BOLD}{ticker:<8}{Colors.ENDC} "
              f"{side_color}{side:<8}{Colors.ENDC} "
              f"{qty:>8.2f} "
              f"${price:>10.2f}")

    print_header("🔧 Stato Sistema")
    print(f"\n  {Colors.POS}✅ Sistema:{Colors.ENDC} Attivo")
    print(f"  {Colors.TITLE}📊 Tickers:{Colors.ENDC} {len(tickers)}")
    print(f"  {Colors.TITLE}⏱️ Intervallo:{Colors.ENDC} 5 minuti")
    print(f"  {Colors.TITLE}💰 Capitale:{Colors.ENDC} $500,000")
    print(f"  {Colors.TITLE}🌐 Ambiente:{Colors.ENDC} Paper Trading")

    print(f"\n{Colors.HEADER}{Colors.BOLD}{'='*70}{Colors.ENDC}")
    print(f"{Colors.ACCENT}Prossimo aggiornamento tra 5 minuti...{Colors.ENDC}")
    print(f"{Colors.HEADER}{Colors.BOLD}{'='*70}{Colors.ENDC}\n")

if __name__ == "__main__":
    main()
